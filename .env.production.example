# ------------------------------------------------------------
# Produção — https://conexaocoral.com.br
# Copie para ".env" NO SERVIDOR e preencha os valores marcados com <...>.
# NUNCA versione o .env.
# ------------------------------------------------------------
DJANGO_DEBUG=False
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<chave-longa-e-aleatoria>
DJANGO_ALLOWED_HOSTS=conexaocoral.com.br,www.conexaocoral.com.br
CSRF_TRUSTED_ORIGINS=https://conexaocoral.com.br,https://www.conexaocoral.com.br

# App Flutter Web publicado em outro endereço? Liste aqui (o app Android não precisa de CORS).
CORS_ALLOWED_ORIGINS=https://conexaocoral.com.br,https://www.conexaocoral.com.br

# PostgreSQL
DB_ENGINE=postgres
DB_NAME=conexao_coral
DB_USER=conexao_coral
DB_PASSWORD=<senha-do-banco>
DB_HOST=<host-do-banco>
DB_PORT=5432
DB_CONN_MAX_AGE=60

# JWT — use uma chave diferente da DJANGO_SECRET_KEY
JWT_SIGNING_KEY=<outra-chave-longa-e-aleatoria>
JWT_ACCESS_TOKEN_HOURS=8
JWT_REFRESH_TOKEN_HOURS=24

# Janela de check-in em relação ao início da partida
CHECKIN_HORAS_ANTES=3
CHECKIN_HORAS_DEPOIS=3

# Fotos e logos (pasta media/) servidos pelo próprio Django
SERVIR_MEDIA=True
