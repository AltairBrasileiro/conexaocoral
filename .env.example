# ------------------------------------------------------------
# Copie para ".env" e ajuste os valores. NUNCA versione o .env!
# ------------------------------------------------------------
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-bem-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco: "sqlite" (padrão, para testes) ou "postgres"
DB_ENGINE=sqlite

# PostgreSQL (usado apenas quando DB_ENGINE=postgres)
DB_NAME=conexao_coral
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# JWT (tokens registrados em whitelist)
JWT_SIGNING_KEY=troque-por-outra-chave-exclusiva-para-jwt
JWT_ACCESS_TOKEN_HOURS=8
JWT_REFRESH_TOKEN_HOURS=24

# Regras de negócio: janela de check-in em relação ao início da partida
CHECKIN_HORAS_ANTES=3
CHECKIN_HORAS_DEPOIS=3
